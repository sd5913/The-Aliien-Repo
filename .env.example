# Supabase client credentials (public, safe to expose in a Vite SPA).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-side Vercel variables for WeChat website QR login. Never prefix secrets with VITE_.
WECHAT_APP_ID=your-approved-website-app-id
WECHAT_APP_SECRET=your-website-app-secret
WECHAT_REDIRECT_URI=https://your-domain.example/api/wechat/callback
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
