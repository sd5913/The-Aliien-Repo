# Supabase client credentials (public, safe to expose in a Vite SPA).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Enable only on the web after configuring the Apple provider in Supabase.
VITE_ENABLE_APPLE_WEB_AUTH=false

# Required for iOS builds. Use the canonical BothPls website's HTTPS origin.
# VITE_PUBLIC_APP_ORIGIN=https://your-bothpls-domain.example
