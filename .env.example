# Supabase client credentials (public, safe to expose in a Vite SPA).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Browser translation via translate.js; no translation API key required.
# Enabled by default. Set false and rebuild to disable.
VITE_POLL_TRANSLATION_ENABLED=true
